{
  "name": "smartgymbro",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "android:sync": "npm run android:sync --workspace frontend",
    "android:open": "npm run android:open --workspace frontend",
    "android:apk": "npm run android:apk --workspace frontend",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "npm run start --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run test --workspace backend && npm run test --workspace frontend && npm run supabase:test",
    "test:frontend": "npm run test --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "db:generate": "npm run db:generate --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend --",
    "db:seed": "npm run db:seed --workspace backend",
    "firebase:emulators": "node --use-system-ca node_modules/firebase-tools/lib/bin/firebase.js emulators:start --only dataconnect --project demo-gymbro-local --import=.firebase/local-data --export-on-exit=.firebase/local-data",
    "firebase:test": "node tools/firebase-smoke.mjs",
    "firebase:cloud:status": "node --use-system-ca tools/cloud-postgres.cjs --status",
    "firebase:cloud:verify": "node --use-system-ca tools/cloud-sql-https.cjs --verify",
    "firebase:cloud:compile": "node --use-system-ca node_modules/firebase-tools/lib/bin/firebase.js dataconnect:compile --config firebase.cloud.json --project gymbro-569e3 --non-interactive",
    "firebase:cloud:tables": "node --use-system-ca tools/cloud-sql-https.cjs --tables",
    "test:recovery": "node tools/verify-workout-recovery.cjs",
    "test:alarms": "node tools/verify-alarms.cjs",
    "supabase:sql": "node tools/build-supabase-sql.mjs",
    "supabase:test": "node --test tools/supabase-schema.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "concurrently": "^9.1.2",
    "firebase-tools": "^15.34.0"
  }
}
