# Puerto HTTP del backend; el proxy de Angular debe apuntar a este servicio.
PORT=3000
# Local sin proxy: 0. En Render, 1; verificar la topología antes de aumentar saltos.
TRUST_PROXY_HOPS=0
# En producción es obligatorio postgres; requiere 09-seguridad.sql.
SECURITY_STORE=memory
# en: nombres anteriores o vistas de compatibilidad. es: tablas traducidas tras SQL 08.
DB_NAMES_LANGUAGE=en
# Conexión de Sequelize: usuario:contraseña@servidor:puerto/base.
DATABASE_URL="postgresql://smartgymbro:smartgymbro@localhost:5433/smartgymbro"
# Secreto usado para firmar y verificar tokens de sesión.
JWT_SECRET="change-this-in-production"
# Origen permitido por CORS para las solicitudes del navegador.
FRONTEND_URL="http://localhost:4200"
# Web en GitHub Pages: usar como origen https://gonzaloapu.github.io (sin /gymbro/).
# Android conserva su origen https://localhost permitido por el backend.

# Recuperación de contraseña: configurar solo en el backend/Render.
# En producción usar la dirección HTTPS pública de la API, nunca https://localhost.
PUBLIC_API_URL="http://localhost:3000"
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Opcional: la bienvenida local funciona sin claves ni llamadas externas.
GEMINI_ENABLED=false
GEMINI_BUDGET_CONFIRMED=false
GEMINI_MAX_REQUESTS_PER_DAY=20
GEMINI_MAX_REQUESTS_PER_MONTH=100
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini 3.5 Flash-Lite usa thinking mínimo; 2.5 conserva thinking desactivado.
# Sin reintentos ni herramientas. Máximo 4096 tokens de salida.
# Confirmar el nivel gratuito y las restricciones de clave en Google antes de activar el permiso.
# Activar Gemini requiere revisar las condiciones del proveedor para perfiles reales.

# Render/Supabase: reemplazar DATABASE_URL con Connect > Session pooler (5432).
# DB_CONNECTION_MODE=SUPABASE
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Si hace falta la CA del proyecto, cargarla como Secret File en Render:
# DB_SSL_CA_FILE=/etc/secrets/supabase-ca.crt
