# Valores de referencia para el PostgreSQL local. Actualmente docker-compose.yml
# fija estos valores y el puerto 5433 directamente; cambiar este archivo no los reemplaza.
POSTGRES_DB=smartgymbro
POSTGRES_USER=smartgymbro
POSTGRES_PASSWORD=smartgymbro
POSTGRES_PORT=5433
# Estas variables sí se interpolan en Compose; :- define un valor alternativo.
PGADMIN_DEFAULT_EMAIL=admin@smartgymbro.com
PGADMIN_DEFAULT_PASSWORD=smartgymbro
PGADMIN_PORT=5050
